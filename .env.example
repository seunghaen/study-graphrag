# 실제 값은 .env 에 넣는다 (.gitignore 처리됨). 이 파일은 "무엇이 필요한지"만 알린다.
#
# 쓰는 법:
#   cp .env.example .env      # 값을 채운다
#   set -a; source .env; set +a
#   python src/ingest.py
#
# set -a 는 "이후 대입하는 변수를 전부 export 하라"는 뜻이다.
# 이게 없으면 셸 변수로만 남아서 파이썬의 os.environ 에 안 보인다.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
